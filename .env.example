# Copy to .env and fill in. Never commit .env.
# Loaded via python-dotenv. Missing required vars fail fast at startup.

# --- State location (optional) ---
# Keep operator state (config/, reports/, data/agent.db) in a SEPARATE git repo,
# version-controlled independently of the code. Point this at your cloned state
# repo and the agent reads/writes config, reports and the DB there. Logs stay
# local. Leave unset to keep everything under the code repo (default). See the
# "Separating state into its own repo" section of the README.
# AGENT_STATE_DIR=/home/ps/endu-news-state

# --- SociaVault (Instagram + Google search) ---
SOCIAVAULT_API_KEY=sk_live_xxx
SOCIAVAULT_DAILY_CREDIT_BUDGET=400            # hard stop guardrail (see §8)
# Note: SociaVault is a global API (it scrapes Instagram server-side), so its
# calls always go DIRECT — they are never routed through OUTBOUND_PROXY_URL.

# --- LLM provider ---
# OpenRouter (recommended): one key for many models, and it returns the real
# per-call cost which the agent logs for the cost report. Model ids come from
# https://openrouter.ai/models and are set per agent in config/agents.yaml.
OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Anthropic API — used when OPENROUTER_API_KEY is unset, and by any agent
# pinned with `provider: anthropic`. (Tokens are logged, but the API doesn't
# return a price, so those calls show $0 in the cost report.)
ANTHROPIC_API_KEY=sk-ant-xxx

# Models for SINGLE-AGENT mode (no config/agents.yaml). With a fleet each agent
# sets its own models instead.
LLM_FILTER_MODEL=claude-haiku-4-5             # cheap/fast per-item relevance filtering
LLM_SUMMARY_MODEL=claude-sonnet-4-6           # stronger model for the twice-weekly summary

# --- Turkish residential proxy (optional) ---
# Used ONLY for direct `.tr` / web fetches that need a Turkish exit IP.
# SociaVault and LLM/email always go direct.
# SOCKS5 is recommended; use socks5h:// so DNS also resolves through the proxy
# (avoids leaking lookups / geo-mismatch). http://, https://, socks5:// and
# socks5h:// are all supported. Leave empty to disable the proxy entirely.
OUTBOUND_PROXY_URL=socks5h://user:pass@tr-proxy-host:port

# --- Web admin interface (suggestions review; run: python -m src.main web) ---
# Bind address. Set to your VPS Tailscale IP (100.x.y.z) so the UI is reachable
# ONLY over your tailnet — it has no authentication. Default 127.0.0.1 = localhost
# only. NEVER set 0.0.0.0 on a public VPS.
WEB_LISTEN_HOST=127.0.0.1
WEB_LISTEN_PORT=8765

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=agent@yourstore.com
SMTP_PASS=changeme
REPORT_FROM=agent@yourstore.com
REPORT_TO=founder@yourstore.com               # comma-separated allowed

# --- First-run / behaviour knobs (optional; defaults shown) ---
# Ignore any post/article published BEFORE this date (YYYY-MM-DD, Europe/Istanbul).
# Set it on first deploy so the agent doesn't backfill old history. Items before
# this date are dropped at ingestion and never enter the DB. Leave empty for no floor.
# When set, this is the authoritative first-run gate (overrides the "most-recent N"
# limits below for sources that expose dates).
INGEST_SINCE_DATE=2026-06-30
IG_FIRST_RUN_LIMIT=6                          # most-recent N posts on first run (used only when INGEST_SINCE_DATE is empty)
WEB_FIRST_RUN_LIMIT=6                         # most-recent N RSS entries on first run (used only when INGEST_SINCE_DATE is empty)
SITE_MAX_NEW_PER_RUN=15                       # cap new articles per raw site per run
RAW_ITEM_RETENTION_DAYS=90                    # purge raw items older than this (legal/operational)
